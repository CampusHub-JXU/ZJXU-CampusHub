                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/campus_widget_text_secondary"
                    android:textSize="13sp" />

                <FrameLayout
